<?xml version="1.0"?>
<!--
  HiveServer2 4.0.1 on Tez over the cluster (plan section 16). The metastore is the image's
  embedded Derby: it holds only the definitions of external tables over job outputs, rebuilt from
  hive/tables.sql by scripts/run-hive.sh.
-->
<configuration>
  <!-- Queries run as the server's user, hadoop, which owns the job outputs. -->
  <property><name>hive.server2.enable.doAs</name><value>false</value></property>
  <property><name>hive.exec.scratchdir</name><value>/tmp/hive</value></property>
  <property><name>hive.metastore.warehouse.dir</name><value>/user/hive/warehouse</value></property>
  <property><name>hive.user.install.directory</name><value>/user</value></property>
  <!-- Every query is a job on the cluster: no local mode, and no fetch task reading HDFS from
       the server. -->
  <property><name>hive.exec.mode.local.auto</name><value>false</value></property>
  <property><name>hive.fetch.task.conversion</name><value>none</value></property>
  <!-- Hive 4.0 still loads commons-collections 3, which Hadoop 3.4 no longer ships. -->
  <property><name>hive.aux.jars.path</name><value>file:///opt/hive/lib/commons-collections-3.2.2.jar</value></property>

  <property><name>hive.execution.engine</name><value>tez</value></property>
  <property><name>tez.local.mode</name><value>false</value></property>
  <property><name>hive.server2.tez.initialize.default.sessions</name><value>false</value></property>
  <!-- Tez 0.10.4's own jars, put in HDFS by scripts/run-hive.sh without the Hadoop 3.3.6 jars it
       ships; its containers take the cluster's Hadoop 3.4.3 instead. -->
  <property><name>tez.lib.uris</name><value>hdfs://namenode:8020/apps/tez-0.10.4,hdfs://namenode:8020/apps/tez-0.10.4/lib</value></property>
  <property><name>tez.use.cluster.hadoop-libs</name><value>true</value></property>
  <property><name>tez.cluster.additional.classpath.prefix</name><value>/opt/hadoop/share/hadoop/mapreduce/*:/opt/hadoop/share/hadoop/mapreduce/lib/*</value></property>
  <property><name>tez.am.launch.env</name><value>HADOOP_COMMON_HOME=/opt/hadoop,HADOOP_HDFS_HOME=/opt/hadoop,HADOOP_YARN_HOME=/opt/hadoop,HADOOP_MAPRED_HOME=/opt/hadoop</value></property>
  <property><name>tez.task.launch.env</name><value>HADOOP_COMMON_HOME=/opt/hadoop,HADOOP_HDFS_HOME=/opt/hadoop,HADOOP_YARN_HOME=/opt/hadoop,HADOOP_MAPRED_HOME=/opt/hadoop</value></property>
  <!-- The same container sizes as the MapReduce jobs (cluster/hadoop.env). -->
  <property><name>tez.am.resource.memory.mb</name><value>1536</value></property>
  <property><name>hive.tez.container.size</name><value>2048</value></property>
  <property><name>hive.tez.java.opts</name><value>-Xmx1600m</value></property>
</configuration>
