CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=/data/name
HDFS-SITE.XML_dfs.datanode.data.dir=/data/dn
HDFS-SITE.XML_dfs.replication=3
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
MAPRED-SITE.XML_mapreduce.framework.name=yarn
MAPRED-SITE.XML_yarn.app.mapreduce.am.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.map.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.reduce.env=HADOOP_MAPRED_HOME=/opt/hadoop
MAPRED-SITE.XML_mapreduce.jobhistory.address=historyserver:10020
MAPRED-SITE.XML_mapreduce.jobhistory.webapp.address=historyserver:19888
MAPRED-SITE.XML_yarn.app.mapreduce.am.resource.mb=1536
MAPRED-SITE.XML_mapreduce.map.memory.mb=2048
MAPRED-SITE.XML_mapreduce.reduce.memory.mb=2048
MAPRED-SITE.XML_mapreduce.map.java.opts=-Xmx1600m
MAPRED-SITE.XML_mapreduce.reduce.java.opts=-Xmx1600m
YARN-SITE.XML_yarn.resourcemanager.hostname=resourcemanager
YARN-SITE.XML_yarn.nodemanager.aux-services=mapreduce_shuffle
YARN-SITE.XML_yarn.nodemanager.pmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.vmem-check-enabled=false
YARN-SITE.XML_yarn.nodemanager.resource.memory-mb=6144
YARN-SITE.XML_yarn.nodemanager.resource.cpu-vcores=3
YARN-SITE.XML_yarn.scheduler.maximum-allocation-mb=6144
YARN-SITE.XML_yarn.log-aggregation-enable=true
YARN-SITE.XML_yarn.nodemanager.remote-app-log-dir=/app-logs
YARN-SITE.XML_yarn.log.server.url=http://historyserver:19888/jobhistory/logs
# Failure detection shortened for the recovery tests, so a killed daemon is noticed in about a
# minute instead of the ten that the defaults allow. A DataNode is declared dead after
# 2 x recheck-interval + 10 x heartbeat (3 s) = 60 s.
HDFS-SITE.XML_dfs.namenode.heartbeat.recheck-interval=15000
YARN-SITE.XML_yarn.nm.liveness-monitor.expiry-interval-ms=60000
MAPRED-SITE.XML_mapreduce.task.timeout=60000
# Three DataNodes at replication 3 leave no spare: a write pipeline that loses a DataNode cannot
# replace it, and by default the write then fails. Phase 4 lost two jobs' history files this way
# (their data output was intact). Best-effort carries the write on with the two that remain; the
# NameNode restores the third copy once a DataNode is back. Hadoop's own notes advise this, or
# disabling replacement, for clusters of three nodes or fewer.
HDFS-SITE.XML_dfs.client.block.write.replace-datanode-on-failure.best-effort=true
# HiveServer2 (the hive service in compose.yaml) runs as hadoop and acts for its session's user
# against HDFS and YARN, which both refuse unless hadoop is declared a proxy user.
CORE-SITE.XML_hadoop.proxyuser.hadoop.hosts=*
CORE-SITE.XML_hadoop.proxyuser.hadoop.groups=*
